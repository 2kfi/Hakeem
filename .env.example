# Hakeem Backend — Environment Configuration (Example)
# =============================================
# REQUIRED — set these before running:
#   JWT_SECRET=<generated with: python scripts/generate_secrets.py --random>
#   LLM_API_KEY=<your Groq/OpenAI key>
#
# Run `python scripts/generate_secrets.py` to auto-generate
# a .env with cryptographically secure values.
# =============================================

# REQUIRED — JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_long_random_secret

# REQUIRED — LLM API key (Groq, OpenAI, or compatible)
LLM_API_KEY=gsk_your_groq_api_key_here

# Redis (defaults match docker-compose.yml)
# REDIS_URL=redis://:password@host:6379/0
# REDIS_PASSWORD=your_redis_password

# Neo4j (for MedRAG knowledge graph)
# NEO4J_PASSWORD=your_neo4j_password

# Cluster node identity
# CLUSTER_NODE_ID=node-1

# LLM settings
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_BASE_URL=https://api.groq.com/openai/v1

# Pipeline workers per stage (default: 1)
# PIPELINE_STT_WORKERS=1
# PIPELINE_LLM_WORKERS=1
# PIPELINE_TTS_WORKERS=1
# PIPELINE_WS_WORKERS=1

# Server
# API_PORT=8080
# DEBUG=false

# MedRAG (Medical RAG Pipeline)
# Requires Qdrant + Neo4j running. See docker-compose.infra.yml.
# MEDRAG_ENABLED=false
# MEDRAG_QDRANT_HOST=localhost
# MEDRAG_QDRANT_PORT=6333
# MEDRAG_NEO4J_URI=bolt://localhost:7687
# MEDRAG_NEO4J_PASSWORD=changeMe
# MEDRAG_LLM_API_BASE=http://10.1.1.180:2312/v1
# MEDRAG_LLM_API_KEY=
# MEDRAG_LLM_MODEL=unsloth/gemma-4-E2B
